{
  "$description": "HARDSET design tokens v1.0 (direction 1: Industrial editorial). Single source for tokens.css. Approved by owner 2026-11-13.",
  "color": {
    "ink": { "value": "#1F2524", "role": "text, rules, dark surfaces" },
    "paper": { "value": "#F2EFE8", "role": "page and light surfaces" },
    "oxide": { "value": "#A64B32", "role": "HARDSET accent: action, warning, the SET in the wordmark" },
    "slate": { "value": "#355D6D", "role": "HARDSET Powerbuilding series colour, data and programme" },
    "moss": { "value": "#56634A", "role": "evidence-class labels; reserved for the next programme series" },
    "rule": { "value": "#C9C3B6", "role": "hairlines, table rows on paper" },
    "tint": { "value": "#E7E2D8", "role": "highlighted rows, input fields on paper" },
    "muted": { "value": "#5E6461", "role": "secondary text on paper (5.3:1)" },
    "ink-raised": { "value": "#2A3130", "role": "raised surfaces in dark UI" },
    "paper-muted": { "value": "#B9B4A9", "role": "secondary text on ink (dark UI)" },
    "oxide-on-ink": { "value": "#D9805F", "role": "accent on ink in dark UI" },
    "slate-on-ink": { "value": "#8FB5C4", "role": "data accent on ink in dark UI" },
    "oxide-text": { "value": "#963F29", "role": "oxide for small text on tint (5.35:1); base oxide on tint is 4.43:1" }
  },
  "font": {
    "display": { "value": "'IBM Plex Sans Condensed', 'Arial Narrow', sans-serif", "role": "headings, labels, wordmark" },
    "text": { "value": "'Source Serif 4', Georgia, 'Times New Roman', serif", "role": "running text" },
    "data": { "value": "'IBM Plex Mono', 'Courier New', monospace", "role": "numbers, tables, code, units" }
  },
  "type-scale-pt": {
    "$description": "Print/PDF scale for A5 pages. Running text 10/14.5 pt.",
    "caption": 7.5, "small": 8.5, "text": 10, "lead": 11.5, "h4": 12, "h3": 14, "h2": 18, "h1": 26, "display": 44
  },
  "type-scale-px": {
    "$description": "Screen scale (16 px base).",
    "caption": 12, "small": 14, "text": 16, "lead": 18, "h4": 18, "h3": 20, "h2": 26, "h1": 34, "display": 56
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "none": "0", "field": "4px", "device": "22px" },
  "rule": { "hair": "0.5pt", "thin": "1px", "strong": "2px", "accent": "3px" },
  "page": {
    "format": "A5 148 x 210 mm",
    "margin-mm": { "top": 16, "bottom": 18, "inner": 18, "outer": 16 },
    "columns": 1,
    "measure": "max 68 characters"
  },
  "series": {
    "hardset": { "cover": "paper", "accent": "oxide" },
    "hardset-powerbuilding": { "cover": "slate", "accent": "oxide" },
    "next-programme": { "cover": "moss", "accent": "oxide" }
  }
}
